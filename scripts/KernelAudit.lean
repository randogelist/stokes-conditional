-- Generated by scripts/verify.py. Audit mechanism, not a theorem source.
import All
import Lean.Util.CollectAxioms
import Lean.Elab.Command

open Lean Elab Command

set_option maxRecDepth 10000
set_option maxHeartbeats 0

run_cmd do
  let env ← getEnv
  let projectModules : Array Name := #[
    `Audit,
    `ConcreteABCDUnifiedClosure,
    `Fefferman.Analysis,
    `Fefferman.CanonicalSource,
    `Fefferman.Continuation,
    `Fefferman.DerivationSupport,
    `Fefferman.FiniteSpectral,
    `Fefferman.ForceRegimes,
    `Fefferman.IntrinsicIdentification,
    `Fefferman.KernelAlgebra,
    `Fefferman.KernelBirth,
    `Fefferman.KernelCalculus,
    `Fefferman.KernelCapacity,
    `Fefferman.KernelCovariance,
    `Fefferman.KernelCritical,
    `Fefferman.KernelGeometry,
    `Fefferman.KernelPackets,
    `Fefferman.KernelRenewal,
    `Fefferman.KernelStorage,
    `Fefferman.Logic,
    `Fefferman.MasterAC,
    `Fefferman.MasterCore,
    `Fefferman.MovingFrame,
    `Fefferman.Obstructions,
    `Fefferman.PhysicsClassical,
    `Fefferman.PhysicsGravity,
    `Fefferman.PhysicsQuantum,
    `Fefferman.PhysicsUnification,
    `Fefferman.PhysicsVariationalTransport,
    `Fefferman.ProjectRoutes,
    `Fefferman.R3SourceBranch,
    `Fefferman.ReconstructedRoutes,
    `Fefferman.ReducedCapacity,
    `Fefferman.ScalarLedger,
    `Fefferman.SourceGeometry,
    `Fefferman.Statements,
    `Fefferman.T3IntegralBranch,
    `«Feffermann-Classification»,
    `LayerA_Mathematics,
    `LayerB_Physics,
    `Master_R3_derivation,
    `Master_R3_details,
    `Master_T3,
    `Master_T3_derivation,
    `Master_T3_details,
    `Master_r3,
    `NSE.Audit,
    `NSE.Completion,
    `NSE.Continuation,
    `NSE.CriticalBalance,
    `NSE.HilbertEntrance,
    `NSE.Injection,
    `NSE.LHLedger,
    `NSE.NSEAnchor,
    `NSE.PrefixPayment,
    `NSE.Representation,
    `NSE.Serrin,
    `NSEForcingRegularityClasses,
    `Types
  ]
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  for mod in projectModules do
    unless (env.getModuleIdx? mod).isSome do
      throwError "Missing project module in audit environment: {mod}"
  let mut declarations : Nat := 0
  let mut theorems : Nat := 0
  for (name, ci) in env.constants do
    if let some idx := env.getModuleIdxFor? name then
      if projectModules.contains env.header.moduleNames[idx]! then
        declarations := declarations + 1
        if ci.isUnsafe then
          throwError "Unsafe project declaration: {name}"
        if let .axiomInfo _ := ci then
          throwError "Custom axiom declaration: {name}"
        let axioms ← collectAxioms name
        for ax in axioms do
          unless allowed.contains ax do
            throwError "Unexpected axiom in {name}: {ax}"
        if let .thmInfo _ := ci then
          theorems := theorems + 1
          logInfo m!"PROJECT_THEOREM_AXIOMS|{name}|{axioms}"
  if declarations == 0 || theorems == 0 then
    throwError "Audit scope was empty"
  logInfo m!"PROJECT_MODULES_CHECKED={projectModules.size}"
  logInfo m!"PROJECT_DECLARATIONS_CHECKED={declarations}"
  logInfo m!"PROJECT_THEOREMS_CHECKED={theorems}"
  logInfo "PROJECT_AXIOM_ALLOWLIST=PASS"
  logInfo "UNCONDITIONAL_FEFFERMAN_ENDPOINTS=NOT_ESTABLISHED"
